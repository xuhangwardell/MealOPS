{
    "name": "mealops-frontend",
    "version": "0.0.1",
    "private": true,
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev:h5": "uni --host 127.0.0.1 --port 5173",
        "build:h5": "uni build",
        "dev:mp-weixin": "uni -p mp-weixin",
        "build:mp-weixin": "uni build -p mp-weixin",
        "lint": "eslint . --max-warnings=0",
        "type-check": "vue-tsc --noEmit -p tsconfig.json",
        "test": "vitest",
        "test:run": "vitest run",
        "verify": "npm run lint && npm run type-check && npm run test:run && npm run build:h5 && npm run build:mp-weixin"
    },
    "dependencies": {
        "@dcloudio/uni-app": "3.0.0-5010520260709002",
        "@dcloudio/uni-components": "3.0.0-5010520260709002",
        "@dcloudio/uni-h5": "3.0.0-5010520260709002",
        "@dcloudio/uni-mp-weixin": "3.0.0-5010520260709002",
        "pinia": "2.3.1",
        "vue": "3.5.41",
        "vue-i18n": "9.14.5"
    },
    "devDependencies": {
        "@dcloudio/types": "3.4.31",
        "@dcloudio/uni-cli-shared": "3.0.0-5010520260709002",
        "@dcloudio/uni-stacktracey": "3.0.0-5010520260709002",
        "@dcloudio/vite-plugin-uni": "3.0.0-5010520260709002",
        "@eslint/js": "9.39.5",
        "@types/node": "20.17.57",
        "@vue/runtime-core": "3.5.41",
        "@vue/tsconfig": "0.1.3",
        "eslint": "9.39.5",
        "eslint-plugin-vue": "9.33.0",
        "globals": "17.9.0",
        "sass": "1.102.0",
        "typescript": "4.9.5",
        "typescript-eslint": "8.66.0",
        "vite": "5.2.8",
        "vitest": "2.1.9",
        "vue-eslint-parser": "9.4.3",
        "vue-tsc": "1.8.27"
    }
}
